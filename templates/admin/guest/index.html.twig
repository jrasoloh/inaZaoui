{% extends 'admin.html.twig' %}

{% block admin %}
    <div class="d-flex justify-content-between align-items-center">
        <h1>Invités</h1>
        <a href="{{ path('admin_guest_add') }}" class="btn btn-primary">Ajouter</a>
    </div>

    <form method="post" action="{{ path('admin_guest_revoke') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('revoke_guests') }}">

        <div class="d-flex justify-content-end my-3">
            <button type="submit" id="revoke-selection" class="btn btn-outline-danger" disabled
                    onclick="return confirm('Révoquer l’accès des invités sélectionnés ?')">
                Révoquer la sélection
            </button>
        </div>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for guest in guests %}
                    <tr>
                        <td><input type="checkbox" class="guest-checkbox" name="guests[]" value="{{ guest.id }}"></td>
                        <td>{{ guest.name }}</td>
                        <td>{{ guest.email }}</td>
                        <td>
                            {% if guest.active %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary">Bloqué</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('admin_guest_toggle', {id: guest.id}) }}"
                               class="btn btn-sm {{ guest.active ? 'btn-warning' : 'btn-success' }}">
                                {{ guest.active ? 'Bloquer' : 'Débloquer' }}
                            </a>
                            <a href="{{ path('admin_guest_delete', {id: guest.id}) }}"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Supprimer cet invité et toutes ses photos ?')">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun invité.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var revokeButton = document.getElementById('revoke-selection');
            var checkboxes = document.querySelectorAll('.guest-checkbox');
            if (!revokeButton || checkboxes.length === 0) {
                return;
            }

            function refreshRevokeButton() {
                var hasSelection = Array.prototype.some.call(checkboxes, function (checkbox) {
                    return checkbox.checked;
                });
                revokeButton.disabled = !hasSelection;
            }

            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', refreshRevokeButton);
            });

            // État initial (ex. après un retour navigateur qui garde les cases cochées).
            refreshRevokeButton();
        });
    </script>
{% endblock %}

